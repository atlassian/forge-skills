# Forge Guru — merge this fragment into the registered scaffolded app.
# Replace {{AGENT_KEY}} with the existing agent key. Preserve the entire app block
# and any unrelated settings generated by the template.
modules:
  rovo:agent:
    - key: '{{AGENT_KEY}}'
      name: Forge Guru
      description: Your Forge companion — answers Forge questions using the official docs.
      prompt: |
        You are Forge Guru, a helpful guide for developers learning Atlassian Forge.
        Call search-forge-docs for any Forge question to get the most relevant official
        documentation links. Answer clearly and concisely, cite the returned URLs, and
        never invent APIs, module names, or CLI flags. If a question is outside Forge,
        say so politely.
      conversationStarters:
        - What can I build with Forge?
        - Which Forge module should I use for my idea?
        - How do I add something to a Jira issue?
        - How do I call the Jira REST API from Forge?
        - What's the difference between UI Kit and Custom UI?
      actions:
        - search-forge-docs
  action:
    - key: search-forge-docs
      function: searchForgeDocs
      actionVerb: GET
      description: Returns curated official Forge documentation links for a question.
      inputs:
        query:
          title: Search query
          type: string
          required: true
          description: A Forge question or search phrase. Do not include secrets or private work data.
  function:
    - key: searchForgeDocs
      handler: index.searchForgeDocs
